# --- LLM provider ---
# Pick one or both. LLM_PROVIDER controls which is used by default.
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Real search/competition data (DataForSEO) ---
# Free trial: https://dataforseo.com/ -- required for real search volume + difficulty.
# If unset, the app runs in DATA_MODE=mock (clearly flagged in every response) so the
# app is still runnable end-to-end during review without a paid account.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATA_MODE=live                  # live | mock

# --- App ---
DATABASE_URL=sqlite:///dev.db
FLASK_ENV=development
SECRET_KEY=change-me

# --- Rate limiting (pipeline trigger endpoint) ---
RUN_RATELIMIT=10 per minute       # limit on POST /profiles/{uuid}/run
RATELIMIT_STORAGE_URI=memory://   # use redis://... for multi-process production
